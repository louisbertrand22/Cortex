---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-32 text-center">
    <p class="font-display text-[8rem] leading-none text-signal">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Cette synapse ne mène nulle part.</h1>
    <p class="mt-3 text-ink-2">La page n'existe pas, ou plus. Essaie la recherche.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-xl bg-ink px-5 py-3 font-medium text-bg">Accueil</a>
      <button type="button" data-search-open class="rounded-xl border border-line-strong bg-surface px-5 py-3 font-medium">Rechercher</button>
    </div>
  </section>
</BaseLayout>
