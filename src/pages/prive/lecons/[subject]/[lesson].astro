---
// Copie des leçons des matières publiques avec la navigation latérale complète (matières privées comprises).
// Verrouillée par middleware.ts, qui la sert à l'adresse /cours/<matière>/<leçon>/ aux visiteurs connectés.
// Les leçons privées n'ont pas besoin de copie : leur navigation est déjà complète.
import LessonPage from '@/components/layout/LessonPage.astro';
import { getSubjects, lessonPaths, type Lesson } from '@/lib/content';

export async function getStaticPaths() {
  const publicIds = new Set((await getSubjects('public')).map((s) => s.id));
  return lessonPaths((id) => publicIds.has(id));
}

interface Props { lesson: Lesson; prev?: Lesson; next?: Lesson }
---
<LessonPage {...Astro.props} fullNav />
