---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NeuralField from '@/components/layout/NeuralField.astro';
import SubjectCard from '@/components/layout/SubjectCard.astro';
import { getNavTree, lessonUrl } from '@/lib/content';

const tree = await getNavTree();
const allLessons = tree.flatMap((t) => t.lessons);
const latest = [...allLessons].sort((a, b) => +b.data.updated - +a.data.updated).slice(0, 3);
const firstLesson = allLessons[0];
---
<BaseLayout>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 opacity-70 [mask-image:radial-gradient(ellipse_at_70%_40%,black_20%,transparent_70%)]">
      <NeuralField />
    </div>
    <div class="relative mx-auto max-w-[90rem] px-4 pt-20 pb-24 sm:px-6 sm:pt-28 sm:pb-32">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3 py-1 font-mono text-xs tracking-[0.12em] text-ink-2 uppercase backdrop-blur" data-reveal>
        <span class="size-1.5 animate-pulse rounded-full bg-signal"></span> EPITA · Majeure SIGL
      </p>
      <h1 class="max-w-4xl text-[clamp(2.75rem,7vw,5.75rem)] leading-[0.95] font-semibold tracking-[-0.045em] text-balance" data-reveal style="--reveal-i:1">
        Des cours bruts aux <span class="font-display font-normal tracking-[-0.02em] text-signal italic">schémas qui restent.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-pretty text-ink-2 sm:text-xl" data-reveal style="--reveal-i:2">
        Cortex transforme mes supports de cours en pages de révision visuelles : diagrammes, schémas animés, quiz, et des approfondissements qui vont au-delà du support.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-i:3">
        {firstLesson && (
          <a href={lessonUrl(firstLesson)} class="inline-flex h-12 items-center gap-2 rounded-xl bg-ink px-5 font-medium text-bg transition-transform duration-300 ease-out-expo hover:-translate-y-0.5">
            Reprendre : {firstLesson.data.title} <span aria-hidden="true">→</span>
          </a>
        )}
        <button type="button" data-search-open class="inline-flex h-12 items-center gap-2 rounded-xl border border-line-strong bg-surface px-5 font-medium text-ink transition-colors hover:bg-surface-2">
          Chercher un concept <kbd class="rounded border border-line bg-surface-2 px-1.5 font-mono text-xs text-ink-3">/</kbd>
        </button>
      </div>
      <dl class="mt-16 grid max-w-xl grid-cols-3 gap-6 border-t border-line pt-6" data-reveal style="--reveal-i:4">
        <div><dt class="text-xs text-ink-3">Matières</dt><dd class="font-display text-4xl tabular-nums">{tree.length}</dd></div>
        <div><dt class="text-xs text-ink-3">Sessions</dt><dd class="font-display text-4xl tabular-nums">{allLessons.length}</dd></div>
        <div><dt class="text-xs text-ink-3">Mis à jour</dt><dd class="font-display text-4xl">{latest[0]?.data.updated.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' }) ?? '—'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6">
    <div class="mb-10 flex items-end justify-between gap-6">
      <div>
        <p class="mb-2 font-mono text-xs tracking-[0.14em] text-ink-3 uppercase">Bibliothèque</p>
        <h2 class="text-3xl font-semibold tracking-tight">Matières</h2>
      </div>
      <a href="/cours/" class="text-sm text-ink-2 hover:text-ink">Tout voir →</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {tree.map(({ subject, lessons }, i) => <SubjectCard subject={subject} lessons={lessons} index={i} />)}
    </div>
  </section>

  <section class="border-t border-line bg-surface/50">
    <div class="mx-auto grid max-w-[90rem] gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="mb-2 font-mono text-xs tracking-[0.14em] text-ink-3 uppercase">Méthode</p>
        <h2 class="text-3xl font-semibold tracking-tight text-balance">Comment une page est construite</h2>
        <p class="mt-4 leading-relaxed text-ink-2">Chaque session suit le même pipeline. Le code couleur indique toujours d'où vient l'information.</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3">
        {[
          { n: '01', t: 'Le support', d: 'Le contenu du cours, fidèlement restructuré : définitions, chiffres, exemples du prof.', c: 'bg-signal' },
          { n: '02', t: 'L’enrichissement', d: 'Approfondissements, état de l’art, best practices, signalés « Pour aller plus loin ».', c: 'bg-synapse' },
          { n: '03', t: 'La visualisation', d: 'Séquences, architectures, schémas animés et quiz pour ancrer chaque concept.', c: 'bg-ink' },
        ].map((s, i) => (
          <li class="rounded-2xl border border-line bg-surface p-6 shadow-card" data-reveal style={`--reveal-i:${i}`}>
            <span class:list={['mb-6 block h-1 w-10 rounded-full', s.c]} />
            <p class="font-mono text-xs text-ink-3">{s.n}</p>
            <h3 class="mt-1 font-semibold">{s.t}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
