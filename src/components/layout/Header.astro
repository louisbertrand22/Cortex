---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props { showMenu?: boolean }
const { showMenu = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line/80 bg-bg/80 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/65">
  <div class="mx-auto flex h-16 max-w-[120rem] items-center gap-3 px-4 sm:px-6">
    {showMenu && <button
      type="button"
      data-sidebar-toggle
      class="-ml-1 inline-flex rounded-lg p-2 text-ink-2 hover:bg-surface-2 hover:text-ink lg:hidden"
      aria-label="Ouvrir la navigation"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
    </button>}

    <a href="/" class="group flex items-center gap-2.5" aria-label="Cortex — accueil">
      <Logo class="size-7 transition-transform duration-500 ease-out-expo group-hover:rotate-[-8deg]" />
      <span class="font-display text-[1.6rem] leading-none tracking-tight">Cortex</span>
    </a>

    <nav class="ml-6 hidden items-center gap-1 text-sm md:flex" aria-label="Principale">
      <a href="/cours/" class:list={['rounded-lg px-3 py-1.5 transition-colors hover:bg-surface-2 hover:text-ink', path.startsWith('/cours') ? 'text-ink' : 'text-ink-2']}>Cours</a>
      <a href="/guide/" class:list={['rounded-lg px-3 py-1.5 transition-colors hover:bg-surface-2 hover:text-ink', path.startsWith('/guide') ? 'text-ink' : 'text-ink-2']}>Composants</a>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="group flex h-9 items-center gap-2 whitespace-nowrap rounded-xl border border-line bg-surface px-3 text-sm text-ink-3 shadow-card transition-colors hover:border-line-strong hover:text-ink-2 sm:w-64"
        aria-label="Rechercher"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="hidden sm:inline">Rechercher un concept…</span>
        <kbd class="ml-auto hidden shrink-0 rounded-md border border-line bg-surface-2 px-1.5 py-0.5 font-mono text-[0.7rem] text-ink-3 sm:inline">Ctrl K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>
