---
import { domainLabels, lessonUrl, subjectUrl, type Lesson, type Subject } from '@/lib/content';
interface Props { subject: Subject; lessons: Lesson[]; index?: number }
const { subject, lessons, index = 0 } = Astro.props;
const planned = Math.max(subject.data.plannedSessions ?? lessons.length, lessons.length);
const done = new Set(lessons.map((l) => l.data.session));
---
<article class="group relative flex flex-col overflow-hidden rounded-3xl border border-line bg-surface p-7 shadow-card transition-[border-color,transform] duration-500 ease-out-expo hover:-translate-y-1 hover:border-line-strong" data-reveal style={`--reveal-i:${index}`}>
  <div class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-signal/10 blur-3xl transition-opacity duration-700 group-hover:opacity-100 opacity-40" aria-hidden="true"></div>
  <div class="mb-5 flex items-center justify-between">
    <span class="font-mono text-xs tracking-[0.14em] text-ink-3 uppercase">{domainLabels[subject.data.domain]} · {subject.data.semester}</span>
    <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-ink-2">{subject.data.short}</span>
  </div>
  <h3 class="text-2xl font-semibold tracking-tight">
    <a href={subjectUrl(subject)} class="after:absolute after:inset-0">{subject.data.title}</a>
  </h3>
  <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{subject.data.description}</p>
  {subject.data.teacher && <p class="mt-3 text-sm text-ink-3">avec {subject.data.teacher}</p>}

  <div class="mt-auto pt-8">
    <div class="mb-2 flex justify-between text-xs text-ink-3">
      <span>{lessons.length} / {planned} sessions</span>
      <span class="transition-transform duration-500 ease-out-expo group-hover:translate-x-1">Ouvrir →</span>
    </div>
    <ol class="flex gap-1.5">
      {Array.from({ length: planned }, (_, i) => {
        const l = lessons.find((x) => x.data.session === i + 1);
        return (
          <li class="flex-1">
            {l ? (
              <a href={lessonUrl(l)} class="relative z-10 block h-1.5 rounded-full bg-signal hover:bg-ink" title={`S${i + 1} · ${l.data.title}`} />
            ) : (
              <span class:list={['block h-1.5 rounded-full', done.has(i + 1) ? 'bg-signal' : 'bg-line']} title={`S${i + 1} · à venir`} />
            )}
          </li>
        );
      })}
    </ol>
  </div>
</article>
