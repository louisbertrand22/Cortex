---
/**
 * Fond décoratif du hero : un réseau de neurones vivant (canvas). Les neurones dérivent lentement, des influx
 * parcourent les synapses et se propagent en cascade ; le curseur excite les neurones proches, un clic déclenche
 * une salve. Mouvement réduit : une seule image fixe. Pause quand le hero sort de l'écran ou que l'onglet est caché.
 */
---
<canvas data-neural-field class="block h-full w-full" aria-hidden="true"></canvas>
<script>
  type Node = { bx: number; by: number; x: number; y: number; z: number; ph: number; amp: number; act: number; links: number[]; last: number };
  type Pulse = { from: number; to: number; t: number; len: number; hue: 0 | 1; gen: number };

  const MAX_PULSES = 90;
  const SPEED = 170; // px/s

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-neural-field]')) {
    const ctx = canvas.getContext('2d');
    if (!ctx) continue;
    const host = canvas.closest('section') ?? canvas.parentElement!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    let w = 0, h = 0, dpr = 1;
    let nodes: Node[] = [];
    let pulses: Pulse[] = [];
    let colors = { line: '', ink: '', signal: '', synapse: '' };
    let pointer: { x: number; y: number } | null = null;
    let raf = 0, prev = 0, nextSpark = 0, visible = true;

    // Même teinte, opacité nulle (« transparent » tirerait la traîne vers le noir)
    const clear = (hex: string) => hex.startsWith('#') && hex.length === 7
      ? `rgb(${parseInt(hex.slice(1, 3), 16)} ${parseInt(hex.slice(3, 5), 16)} ${parseInt(hex.slice(5, 7), 16)} / 0)`
      : 'transparent';

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors = {
        line: s.getPropertyValue('--line-strong').trim(),
        ink: s.getPropertyValue('--ink-3').trim(),
        signal: s.getPropertyValue('--signal').trim(),
        synapse: s.getPropertyValue('--synapse').trim(),
      };
    };

    // Graine fixe : le réseau a la même forme à chaque visite
    let seed = 7;
    const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

    const build = () => {
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      seed = 7;
      // Grille jitterée : répartition régulière sans alignement visible
      const cell = w < 640 ? 70 : 92;
      const cols = Math.ceil(w / cell) + 1, rows = Math.ceil(h / cell) + 1;
      nodes = [];
      for (let j = 0; j < rows; j++)
        for (let i = 0; i < cols; i++) {
          if (rand() < 0.18) continue;
          const bx = (i - 0.25 + rand() * 0.9) * cell, by = (j - 0.25 + rand() * 0.9) * cell;
          nodes.push({ bx, by, x: bx, y: by, z: 0.35 + rand() * 0.65, ph: rand() * Math.PI * 2, amp: 6 + rand() * 12, act: 0, links: [], last: -1e9 });
        }
      // Chaque neurone se relie à ses 2-3 plus proches voisins
      const max = cell * 1.75;
      nodes.forEach((n, a) => {
        const near = nodes
          .map((m, b) => ({ b, d: Math.hypot(m.bx - n.bx, m.by - n.by) }))
          .filter((o) => o.b !== a && o.d < max)
          .sort((p, q) => p.d - q.d)
          .slice(0, 2 + (rand() < 0.5 ? 1 : 0));
        for (const { b } of near) {
          if (!n.links.includes(b)) n.links.push(b);
          if (!nodes[b].links.includes(a)) nodes[b].links.push(a);
        }
      });
      pulses = [];
    };

    const fire = (i: number, now: number, gen: number, hue: 0 | 1, from = -1) => {
      const n = nodes[i];
      if (now - n.last < 380) return; // période réfractaire : évite les boucles
      n.last = now; n.act = 1;
      if (gen > 6) return;
      const out = n.links.filter((b) => b !== from);
      const k = gen === 0 ? out.length : Math.min(out.length, rand() < 0.35 ? 2 : 1);
      for (const to of out.sort(() => rand() - 0.5).slice(0, k)) {
        if (pulses.length >= MAX_PULSES) break;
        if (gen > 0 && rand() < 0.22) continue; // l'influx s'éteint parfois
        const m = nodes[to];
        pulses.push({ from: i, to, t: 0, len: Math.hypot(m.x - n.x, m.y - n.y), hue, gen: gen + 1 });
      }
    };

    const nearest = (x: number, y: number) => {
      let best = -1, bd = Infinity;
      nodes.forEach((n, i) => { const d = Math.hypot(n.x - x, n.y - y); if (d < bd) { bd = d; best = i; } });
      return { i: best, d: bd };
    };

    const step = (now: number, dt: number) => {
      const t = now / 1000;
      for (const n of nodes) {
        n.x = n.bx + Math.sin(t * 0.21 + n.ph) * n.amp;
        n.y = n.by + Math.cos(t * 0.17 + n.ph * 1.3) * n.amp * 0.7;
        n.act = Math.max(0, n.act - dt * 1.4);
      }
      if (now > nextSpark) {
        // Influx spontanés, plus nombreux à droite (là où le masque laisse voir le réseau)
        const pool = nodes.map((n, i) => ({ i, s: rand() * (0.4 + n.bx / w) })).sort((a, b) => b.s - a.s);
        fire(pool[0].i, now, 0, rand() < 0.62 ? 0 : 1);
        nextSpark = now + 380 + rand() * 600;
      }
      if (pointer) {
        const { i, d } = nearest(pointer.x, pointer.y);
        if (i >= 0 && d < 70) fire(i, now, 2, 1);
      }
      pulses = pulses.filter((p) => {
        p.t += (dt * SPEED) / Math.max(p.len, 1);
        if (p.t >= 1) { fire(p.to, now, p.gen, p.hue, p.from); return false; }
        return true;
      });
    };

    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = 'round';

      // Synapses : plus nettes au premier plan, ravivées par l'activité de leurs neurones
      ctx.strokeStyle = colors.line;
      nodes.forEach((n, a) => {
        for (const b of n.links) {
          if (b < a) continue;
          const m = nodes[b];
          ctx.globalAlpha = 0.35 + 0.45 * ((n.z + m.z) / 2) + 0.4 * Math.max(n.act, m.act);
          ctx.lineWidth = 0.6 + 0.6 * ((n.z + m.z) / 2);
          ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(m.x, m.y); ctx.stroke();
        }
      });

      // Influx : une tête lumineuse et une traîne qui s'estompe
      for (const p of pulses) {
        const a = nodes[p.from], b = nodes[p.to];
        const col = p.hue ? colors.synapse : colors.signal;
        const fade = Math.max(0.35, 1 - (p.gen - 1) * 0.14);
        const head = { x: a.x + (b.x - a.x) * p.t, y: a.y + (b.y - a.y) * p.t };
        const t0 = Math.max(0, p.t - 0.45);
        const tail = { x: a.x + (b.x - a.x) * t0, y: a.y + (b.y - a.y) * t0 };
        const g = ctx.createLinearGradient(tail.x, tail.y, head.x, head.y);
        g.addColorStop(0, clear(col)); g.addColorStop(1, col);
        ctx.globalAlpha = fade;
        ctx.strokeStyle = g; ctx.lineWidth = 1.8;
        ctx.beginPath(); ctx.moveTo(tail.x, tail.y); ctx.lineTo(head.x, head.y); ctx.stroke();
        ctx.fillStyle = col;
        ctx.globalAlpha = fade * 0.18;
        ctx.beginPath(); ctx.arc(head.x, head.y, 6, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = fade;
        ctx.beginPath(); ctx.arc(head.x, head.y, 1.9, 0, Math.PI * 2); ctx.fill();
      }

      // Neurones : halo quand ils viennent de décharger
      for (const n of nodes) {
        const r = 1.4 + n.z * 2.2;
        if (n.act > 0.01) {
          ctx.fillStyle = colors.signal;
          ctx.globalAlpha = n.act * 0.16;
          ctx.beginPath(); ctx.arc(n.x, n.y, r + 10 * n.act, 0, Math.PI * 2); ctx.fill();
        }
        ctx.fillStyle = n.act > 0.25 ? colors.signal : colors.ink;
        ctx.globalAlpha = 0.45 + 0.4 * n.z + 0.3 * n.act;
        ctx.beginPath(); ctx.arc(n.x, n.y, r * (1 + 0.5 * n.act), 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      step(now, dt);
      draw();
      raf = requestAnimationFrame(loop);
    };

    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    const start = () => {
      if (raf || !visible || document.hidden) return;
      if (still.matches) {
        // Image fixe : quelques neurones allumés, sans mouvement
        nodes.forEach((n, i) => (n.act = i % 9 === 0 ? 0.8 : 0));
        draw();
        return;
      }
      prev = performance.now();
      raf = requestAnimationFrame(loop);
    };

    readColors();
    build();
    start();
    if (still.matches) draw();

    new ResizeObserver(() => { const r = canvas.getBoundingClientRect(); if (Math.abs(r.width - w) > 1 || Math.abs(r.height - h) > 1) { build(); if (!raf) start(); } }).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    still.addEventListener('change', () => { stop(); start(); });
    const retheme = () => requestAnimationFrame(() => { readColors(); if (!raf) start(); });
    addEventListener('cortex:theme', retheme);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);

    const local = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
    host.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') pointer = local(e); });
    host.addEventListener('pointerleave', () => (pointer = null));
    host.addEventListener('pointerdown', (e) => {
      if (still.matches || (e.target as Element).closest('a, button, input')) return;
      const { x, y } = local(e);
      const { i } = nearest(x, y);
      if (i >= 0) { nodes[i].last = -1e9; fire(i, performance.now(), 0, 0); }
    });
  }
</script>
