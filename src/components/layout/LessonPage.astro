---
// Rendu d'une leçon. Utilisé par /cours/<matière>/<leçon>/ et par sa copie /prive/lecons/… (navigation
// latérale complète), que middleware.ts sert à l'adresse publique aux visiteurs connectés.
import { getEntry, render } from 'astro:content';
import LessonLayout from '@/layouts/LessonLayout.astro';
import { components } from '@/components/mdx';
import type { Lesson } from '@/lib/content';

interface Props { lesson: Lesson; prev?: Lesson; next?: Lesson; fullNav?: boolean }
const { lesson, prev, next, fullNav = false } = Astro.props;
const subject = (await getEntry(lesson.data.subject))!;
const { Content, headings, remarkPluginFrontmatter } = await render(lesson);
---
<LessonLayout
  lesson={lesson}
  subject={subject}
  headings={headings}
  readingTime={remarkPluginFrontmatter.readingTime}
  diagramCount={remarkPluginFrontmatter.diagramCount}
  prev={prev}
  next={next}
  fullNav={fullNav}
>
  <Content components={components} />
</LessonLayout>
