<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-xl border border-line bg-surface text-ink-2 shadow-card transition-colors hover:text-ink"
  aria-label="Basculer le thème clair / sombre"
>
  <svg viewBox="0 0 24 24" class="size-[1.1rem] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
  <svg viewBox="0 0 24 24" class="hidden size-[1.1rem] dark:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('cortex:theme', { detail: next }));
      };
      // Transition douce si le navigateur sait faire
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(apply);
      else apply();
    }),
  );
</script>
