---
// Contenu de /cours/. Deux versions générées : publique (src/pages/cours/index.astro) et complète
// (src/pages/prive/cours.astro), que middleware.ts sert à la place de /cours/ quand le visiteur est connecté.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubjectCard from '@/components/layout/SubjectCard.astro';
import { getNavTree, subjectUrl, type Visibility } from '@/lib/content';
interface Props { visibility: Visibility }
const { visibility } = Astro.props;
const tree = await getNavTree(visibility);
const priv = visibility !== 'public';
const jsonLd = {
  '@type': 'ItemList',
  name: 'Cours',
  itemListElement: tree.map(({ subject }, i) => ({ '@type': 'ListItem', position: i + 1, name: subject.data.title, url: new URL(subjectUrl(subject), Astro.site).href })),
};
---
<BaseLayout title="Cours" description={`Toutes les matières disponibles sur Cortex : ${tree.map(({ subject }) => subject.data.title).join(', ')}. Révisions visuelles et interactives, session par session.`} jsonLd={priv ? undefined : jsonLd} noindex={priv}>
  <section class="mx-auto max-w-[120rem] px-4 py-16 sm:px-6">
    <p class="mb-2 font-mono text-xs tracking-[0.14em] text-ink-3 uppercase">Bibliothèque{priv && ' · connecté'}</p>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-5xl font-semibold tracking-[-0.04em]">Cours</h1>
      {priv && <a href="/deconnexion/" class="rounded-xl border border-line-strong bg-surface px-4 py-2 text-sm font-medium text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink">Se déconnecter</a>}
    </div>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">Toutes les matières traitées, session par session.{priv && ' Celles marquées « privé » ne sont visibles que par toi.'}</p>
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {tree.map(({ subject, lessons }, i) => <SubjectCard subject={subject} lessons={lessons} index={i} />)}
    </div>
  </section>
</BaseLayout>
