---
/** Bandeau des 4 couches TOGAF, avec celles concernées par la section en surbrillance. */
interface Props { active: ('Business' | 'Data' | 'Application' | 'Technology')[] }
const all = [
  { k: 'Business', fr: 'Métier' },
  { k: 'Data', fr: 'Données' },
  { k: 'Application', fr: 'Application' },
  { k: 'Technology', fr: 'Technologie' },
] as const;
const { active } = Astro.props;
---
<div class="not-prose -mt-2 mb-6 flex flex-wrap items-center gap-1.5 text-xs" aria-label="Couches TOGAF concernées">
  <span class="mr-1 font-mono text-ink-3 uppercase">Couches</span>
  {all.map((l) => (
    <span class:list={['rounded-md border px-2 py-0.5', active.includes(l.k) ? 'border-signal/50 bg-signal-soft text-ink' : 'border-line text-ink-3']}>{l.fr}</span>
  ))}
</div>
