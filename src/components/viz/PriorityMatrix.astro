---
/** Matrice valeur / complexité des cas d'usage (positions illustratives). */
const items = [
  { t: 'Support niveau 1 automatisé', v: 0.82, c: 0.28 },
  { t: 'Génération & revue de code', v: 0.75, c: 0.36 },
  { t: 'Génération de rapports', v: 0.62, c: 0.22 },
  { t: 'Analyse de contrats', v: 0.7, c: 0.56 },
  { t: 'Formation conversationnelle', v: 0.45, c: 0.46 },
  { t: 'Migration technologique', v: 0.66, c: 0.82 },
  { t: 'Ton projet IoT ?', v: 0.5, c: 0.62, you: true },
];
const W = 600, H = 360, p = 40;
const x = (c: number) => p + c * (W - 2 * p);
const y = (v: number) => H - p - v * (H - 2 * p);
---
<svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label="Matrice valeur ajoutée / complexité">
  <rect x={p} y={p} width={(W - 2 * p) / 2} height={(H - 2 * p) / 2} fill="var(--synapse-soft)" />
  <text x={p + 10} y={p + 20} font-size="12" fill="var(--synapse)" font-weight="600">À FAIRE EN PREMIER</text>
  <line x1={W / 2} x2={W / 2} y1={p} y2={H - p} stroke="var(--line)" stroke-dasharray="4 4" />
  <line x1={p} x2={W - p} y1={H / 2} y2={H / 2} stroke="var(--line)" stroke-dasharray="4 4" />
  <line x1={p} x2={W - p} y1={H - p} y2={H - p} stroke="var(--ink-3)" />
  <line x1={p} x2={p} y1={p} y2={H - p} stroke="var(--ink-3)" />
  <text x={W - p} y={H - 12} text-anchor="end" font-size="12" fill="var(--ink-3)">Complexité →</text>
  <text x={14} y={p} font-size="12" fill="var(--ink-3)" transform={`rotate(-90 14 ${p})`} text-anchor="end">Valeur ajoutée →</text>
  {items.map((it, i) => (
    <g class="pm-dot" style={`--i:${i}`}>
      <circle cx={x(it.c)} cy={y(it.v)} r={it.you ? 7 : 6} fill={it.you ? 'none' : it.v > 0.5 && it.c < 0.5 ? 'var(--signal)' : 'var(--ink-3)'} stroke={it.you ? 'var(--signal)' : 'none'} stroke-width="2" stroke-dasharray={it.you ? '3 2' : undefined} />
      <text x={it.c > 0.6 ? x(it.c) - 11 : x(it.c) + 11} y={y(it.v) + 4} text-anchor={it.c > 0.6 ? 'end' : 'start'} font-size="12" fill="var(--ink)">{it.t}</text>
    </g>
  ))}
</svg>
<style>
  .pm-dot { animation: pm .6s cubic-bezier(.16,1,.3,1) calc(var(--i) * 90ms) both; transform-box: fill-box; }
  @keyframes pm { from { opacity: 0; transform: translateY(8px); } }
</style>
