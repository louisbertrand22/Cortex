---
/**
 * Citation d'un auteur, avec sa référence. Le texte (sans guillemets) va dans le contenu :
 * <Quote author="Platon" work="Théétète" at="155d">C'est tout à fait d'un philosophe…</Quote>
 */
interface Props {
  author: string;
  work?: string;
  at?: string;
}
const { author, work, at } = Astro.props;
---
<figure class="not-prose my-8 max-w-[52rem] border-l-2 border-signal py-1 pl-6" data-reveal>
  <blockquote class="font-display text-[1.375rem] leading-snug text-pretty text-ink sm:text-[1.5rem]">«&nbsp;<slot />&nbsp;»</blockquote>
  <figcaption class="mt-3 text-sm text-ink-3">
    — {author}{work && <>, <cite class="italic">{work}</cite></>}{at && <>, {at}</>}
  </figcaption>
</figure>
