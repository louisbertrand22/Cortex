---
interface Props {
  title: string;
  kicker?: string; // petite étiquette au-dessus du titre (ex. « 01 », « Niveau 2 »)
  tone?: 'default' | 'signal' | 'synapse' | 'amber' | 'danger' | 'muted';
}
const { title, kicker, tone = 'default' } = Astro.props;
const tones = {
  default: 'border-line bg-surface',
  signal: 'border-signal/35 bg-signal-soft',
  synapse: 'border-synapse/35 bg-synapse-soft',
  amber: 'border-amber/35 bg-amber-soft',
  danger: 'border-danger/30 bg-danger-soft',
  muted: 'border-line bg-surface-2',
}[tone];
const kickerColor = { default: 'text-signal', signal: 'text-signal', synapse: 'text-synapse', amber: 'text-amber', danger: 'text-danger', muted: 'text-ink-3' }[tone];
---
<div class:list={['group rounded-2xl border p-5 shadow-card transition-transform duration-500 ease-out-expo hover:-translate-y-0.5', tones]} data-reveal>
  {kicker && <p class:list={['mb-1.5 font-mono text-[0.7rem] tracking-[0.12em] uppercase', kickerColor]}>{kicker}</p>}
  <h4 class="mb-2 font-semibold leading-snug text-ink">{title}</h4>
  <div class="text-[0.9375rem] leading-relaxed text-ink-2 [&_code]:font-mono [&_code]:text-[0.85em] [&_li]:ml-4 [&_li]:list-disc [&_p+p]:mt-2 [&_strong]:text-ink [&_ul]:mt-2 [&_ul]:space-y-1">
    <slot />
  </div>
</div>
