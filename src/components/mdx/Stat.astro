---
interface Props { value: string; label: string; hint?: string }
const { value, label, hint } = Astro.props;
---
<div class="rounded-2xl border border-line bg-surface p-5 shadow-card" data-reveal>
  <p class="font-display text-5xl leading-none text-signal tabular-nums">{value}</p>
  <p class="mt-3 text-sm font-medium text-ink">{label}</p>
  {hint && <p class="mt-1 text-xs text-ink-3">{hint}</p>}
</div>
