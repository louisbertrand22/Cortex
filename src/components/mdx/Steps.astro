---
/** Liste ordonnée rendue en frise verticale numérotée. Mettre une liste `1. …` dedans. */
---
<div class="steps my-8" data-reveal><slot /></div>
<style>
  .steps :global(ol) {
    list-style: none;
    padding-left: 0;
    counter-reset: step;
    margin: 0;
  }
  .steps :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding: 0 0 1.5rem 3.25rem;
    margin: 0;
  }
  .steps :global(ol > li::before) {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 2.1rem;
    height: 2.1rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--signal);
  }
  .steps :global(ol > li::after) {
    content: '';
    position: absolute;
    left: 1.05rem;
    top: 2.5rem;
    bottom: 0.3rem;
    width: 1px;
    background: var(--line);
  }
  .steps :global(ol > li:last-child::after) {
    display: none;
  }
  .steps :global(ol > li > :first-child) {
    margin-top: 0;
  }
</style>
