---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SearchModal from '@/components/layout/SearchModal.astro';
import MermaidRuntime from '@/components/mdx/MermaidRuntime.astro';
import RevealRuntime from '@/components/layout/RevealRuntime.astro';

interface Props {
  title?: string;
  description?: string;
  /** Masque le pied de page (pages de leçon : il est rendu dans la colonne centrale). */
  bare?: boolean;
  /** Affiche le bouton d'ouverture de la navigation latérale sur mobile. */
  sidebar?: boolean;
  /** Image de partage (chemin absolu depuis la racine du site). */
  image?: string;
  /** `article` pour les leçons (Open Graph). */
  type?: 'website' | 'article';
  /** Date de dernière mise à jour (leçons). */
  modified?: Date;
  /** Données structurées schema.org, sérialisées en JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Exclut la page des moteurs de recherche (404…). */
  noindex?: boolean;
}
const {
  title,
  description = 'Des cours rendus visuels et interactifs : schémas animés, diagrammes, quiz et approfondissements. Intelligence artificielle, architecture logicielle et plus.',
  bare = false,
  sidebar = false,
  image = '/og.png',
  type = 'website',
  modified,
  jsonLd,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Cortex` : 'Cortex · Révisions visuelles et interactives';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const structured = jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((d) => ({ '@context': 'https://schema.org', ...d }));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content="Louis Bertrand" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Cortex" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cortex — Muscler le cortex, un cours à la fois." />
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="apple-mobile-web-app-title" content="Cortex" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e11" media="(prefers-color-scheme: dark)" />
    {structured?.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="grain text-ink">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:shadow-card">Aller au contenu</a>
    <div class="relative z-10 flex min-h-dvh flex-col">
      <Header showMenu={sidebar} />
      <main id="contenu" class="flex-1">
        <slot />
      </main>
      {!bare && <Footer />}
    </div>
    <SearchModal />
    <MermaidRuntime />
    <RevealRuntime />
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      </script>
    )}
  </body>
</html>
